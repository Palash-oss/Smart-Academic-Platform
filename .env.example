# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_academic_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/smart_academic_db
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/smart_academic_db

# Security / Auth
JWT_SECRET=academic_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Primary: Gemini, Backup: Grok)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2
